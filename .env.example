# Copy this file to .env and fill in real values before running.

# Required — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-a-long-random-string-here

# Optional — football-data.org API key (covers PL, PD, BL1, SA, FL1, CL, etc.)
FOOTBALL_DATA_API_KEY=

# Defaults shown below — override only if needed
# DATABASE_URL=sqlite:////data/footrack.db
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
